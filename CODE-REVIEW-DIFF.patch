+    padding-bottom: 9px;
+  }
+  .panzoom-shell {
+    flex: 1 1 auto;
+  }
+  .plan-control-row {
+    min-height: 38px;
+    margin-bottom: 6px;
+    gap: 6px;
+  }
+  .plan-toolbar-hint {
+    gap: 5px;
