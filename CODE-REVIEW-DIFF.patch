 }
+
+/* ========================================================================== 
+   Update 03 - mobile page navigation, compact explorer and floor-plan controls
+   ========================================================================== */
+
+/* Keep the main navigation visible with a stronger top fade. */
+.site-header {
+  z-index: 90;
+  background: linear-gradient(
+    180deg,
+    rgba(238, 243, 246, 0.98) 0%,
+    rgba(238, 243, 246, 0.88) 42%,
+    rgba(238, 243, 246, 0.45) 72%,
+    rgba(238, 243, 246, 0) 100%
+  );
+}
+
+/* Original Level 23 artwork is used in the navigation menu. */
+.nav-panel-brand-image {
+  width: min(230px, 62vw);
+  transform: none;
+}
+.nav-panel-brand-image img {
+  display: block;
+  width: 100%;
+  height: auto;
+  object-fit: contain;
+}
+
+.contact-section {
+  background: linear-gradient(180deg, #e7edf1, #dfe7ed);
+}
+
+/* Instruction and zoom controls now share the same row above the plan. */
+.plan-heading-copy {
+  min-width: 0;
+}
+.plan-heading-copy p {
+  max-width: 620px;
+  margin: 7px 0 0;
+  color: var(--muted);
+  font-size: 0.9rem;
+  line-height: 1.45;
+}
+.panzoom-shell {
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+.plan-control-row {
+  position: relative;
+  z-index: 8;
+  flex: 0 0 auto;
+  min-height: 50px;
+  margin-bottom: 10px;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.plan-toolbar-hint {
+  min-width: 0;
+  flex: 1 1 auto;
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  color: var(--muted);
+  font-size: 0.78rem;
+  line-height: 1.4;
+}
+.plan-toolbar-hint svg {
+  flex: 0 0 auto;
+  color: var(--accent);
+}
+.panzoom-shell .plan-toolbar,
+.plan-toolbar {
+  position: static;
+  flex: 0 0 auto;
+  margin-left: auto;
+  transform: none;
+  transform-origin: center;
+}
+.panzoom-viewport {
+  flex: 1 1 auto;
+  min-height: 0;
+}
+
+/* Fixed page-up/page-down guidance for the six main mobile pages. */
+.main-page-navigation {
+  position: fixed;
+  inset: 0;
+  z-index: 80;
+  pointer-events: none;
+}
+.main-page-navigation__control {
+  position: fixed;
+  left: 50%;
+  transform: translateX(-50%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 2px;
+  border: 0;
+  padding: 0;
+  color: #17364d;
+  background: transparent;
+  pointer-events: auto;
+  cursor: pointer;
+  text-transform: uppercase;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  text-shadow: 0 1px 9px rgba(255,255,255,0.9);
+}
+.main-page-navigation__control--up {
+  top: calc(88px + env(safe-area-inset-top, 0px));
+}
+.main-page-navigation__control--down {
+  bottom: max(14px, env(safe-area-inset-bottom, 14px));
+}
+.main-page-navigation__control > span:first-child,
+.main-page-navigation__control small {
+  font-size: 0.55rem;
+  line-height: 1.1;
+}
+.main-page-navigation__circle {
+  width: 38px;
+  height: 38px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(67,90,115,0.34);
+  border-radius: 50%;
+  color: var(--accent);
+  background: rgba(255,255,255,0.82);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+  box-shadow: 0 8px 24px rgba(31,59,78,0.14);
+}
+.main-page-navigation__control--down .main-page-navigation__circle {
+  animation: pageNavigationDown 1.8s ease-in-out infinite;
+}
+.main-page-navigation__control--up .main-page-navigation__circle {
+  animation: pageNavigationUp 1.8s ease-in-out infinite;
+}
+@keyframes pageNavigationDown {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(5px); }
+}
+@keyframes pageNavigationUp {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(-5px); }
+}
+
+@media (max-width: 900px) {
+  html.main-page-snap-enabled,
+  body.main-page-snap-enabled {
+    height: 100%;
+    scroll-behavior: smooth;
+    scroll-snap-type: y mandatory;
+    overscroll-behavior-y: none;
+  }
+
+  body.main-page-snap-enabled main {
+    overflow: visible;
+  }
+
+  body.main-page-snap-enabled .section-screen {
+    width: 100%;
+    height: 100svh;
+    min-height: 100svh;
+    max-height: 100svh;
+    overflow: hidden;
+    scroll-snap-align: start;
+    scroll-snap-stop: always;
+  }
+
+  /* Page 2: building and all six compact floor selectors fit together. */
+  .explorer-inner {
+    height: 100%;
+    padding: 88px 12px 68px;
+    display: flex;
+    flex-direction: column;
+  }
+  .explorer-inner .section-title {
+    flex: 0 0 auto;
+    margin: 0 0 2px;
+  }
+  .explorer-inner .section-title h4 {
+    margin: 0;
+    font-size: clamp(1rem, 4.5vw, 1.25rem);
+    line-height: 1.2;
+  }
+  .model-stage {
+    flex: 1 1 auto;
+    width: 100%;
+    height: auto;
+    min-height: 0;
+    margin: 0;
+    grid-template-columns: 44px minmax(0, 1fr) 44px;
+  }
+  .model-arrow {
+    width: 42px;
+    height: 42px;
+  }
+  .model-arrow svg {
+    width: 22px;
+    height: 22px;
+  }
+  .model-hint {
+    bottom: 0;
+    font-size: 0.68rem;
+  }
+  .model-hint svg {
+    width: 23px;
+    height: 23px;
+  }
+  .floor-picker {
+    flex: 0 0 auto;
+    margin-top: 2px;
+  }
+  .floor-picker > span {
+    font-size: 0.63rem;
+    letter-spacing: 0.26em;
+  }
+  .floor-pills-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 6px;
+    margin-top: 7px;
+    max-width: 560px;
+  }
+  .floor-pills-grid button,
+  .floor-pills-grid button:nth-child(5),
+  .floor-pills-grid button:nth-child(6) {
+    grid-column: auto;
+    min-height: clamp(45px, 7svh, 56px);
+    padding: 4px 7px;
+    border-radius: 16px;
+    gap: 1px;
+  }
+  .floor-pills-grid button strong {
+    font-size: 1.02rem;
+  }
+  .floor-pills-grid button small {
+    font-size: 0.69rem;
+  }
+
+  /* Page 3: heading, selector, instruction, zoom controls and plan stay in-view. */
+  .plan-inner {
+    height: 100%;
+    padding: 88px 10px 66px;
+    display: flex;
+    flex-direction: column;
+  }
+  .plan-heading {
+    flex: 0 0 auto;
+    grid-template-columns: 38px minmax(0, 1fr);
+    gap: 5px 9px;
+    margin: 0 0 8px;
+  }
+  .plan-heading > button {
+    width: 38px;
+    height: 38px;
+  }
+  .plan-heading > button svg {
+    width: 22px;
+  }
+  .plan-heading h2 {
+    font-size: clamp(1.75rem, 8vw, 2.25rem);
