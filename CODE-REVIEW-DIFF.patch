+    grid-template-columns: 1fr;
+    gap: 5px;
+    padding: 7px 11px;
+  }
+  .contact-inner .project-footer-address span {
+    margin-bottom: 2px;
+    font-size: 0.58rem;
+  }
+  .contact-inner .project-footer-address strong {
+    font-size: 0.58rem;
+    line-height: 1.3;
+  }
+  .contact-inner .project-footer-links {
+    flex-direction: row;
+    flex-wrap: wrap;
+    gap: 3px 9px;
+  }
+  .contact-inner .project-footer-links a {
+    gap: 4px;
+    font-size: 0.57rem;
+  }
+  .contact-inner .project-footer-links svg {
+    width: 12px;
+    height: 12px;
+  }
+  .contact-inner .project-footer-legal {
+    flex: 1 1 auto;
+    min-height: 0;
+    padding: 6px 11px 8px;
+    overflow: hidden;
+  }
+  .contact-inner .project-footer-legal a {
+    margin-bottom: 3px;
+    gap: 4px;
+    font-size: 0.57rem;
+  }
+  .contact-inner .project-footer-legal a svg {
+    width: 13px;
+    height: 13px;
+  }
+  .contact-inner .project-footer-legal p {
+    font-size: clamp(0.48rem, 1.65vw, 0.56rem);
+    line-height: 1.25;
+  }
+}
+
+@media (max-width: 430px) and (max-height: 720px) {
+  .explorer-inner {
+    padding-top: 82px;
+    padding-bottom: 58px;
+  }
+  .model-stage {
+    flex-basis: 220px;
+  }
+  .floor-pills-grid button {
+    min-height: 43px;
+  }
+  .plan-inner,
+  .interiors-page .section-inner,
+  .location-inner,
+  .contact-inner {
+    padding-top: 82px;
+    padding-bottom: 56px;
+  }
+  .contact-inner .project-features article {
+    min-height: 58px;
+  }
+  .contact-inner .project-footer-logo-card {
+    height: 36px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .main-page-navigation__circle {
+    animation: none !important;
+  }
+}
