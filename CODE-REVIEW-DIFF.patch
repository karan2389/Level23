+  }
+  .plan-heading-copy p {
+    margin-top: 4px;
+    font-size: 0.67rem;
+    line-height: 1.3;
+  }
+  .plan-heading label {
+    grid-column: 1 / -1;
+    width: 100%;
+    min-width: 0;
+    height: 40px;
+    border-radius: 14px;
+    padding-inline: 14px;
+  }
+  .plan-heading select {
+    font-size: 0.74rem;
+  }
+  .multi-select-banner {
+    flex: 0 0 auto;
+    margin: 0 0 7px;
+    padding: 8px 10px;
+    font-size: 0.68rem;
+  }
+  .floor-plan-card {
+    flex: 1 1 auto;
+    min-height: 0;
